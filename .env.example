# ── b-fit-coach (Evoli Pro) ───────────────────────────────────────────────────
# Copy to .env.local. None of these are secrets; nothing here is inlined into the
# browser bundle, because the browser never talks to b-fit-api directly.

# Where b-fit-api is. NO trailing slash — it is stripped in src/lib/env.ts anyway,
# but a doubled slash 401s the whole app (EV-166 / BUG-065).
API_BASE_URL=http://localhost:8080

# live    — talk to b-fit-api (default; what the demo runs)
# fixture — serve src/lib/coachApi.fixture.ts, no api and no database needed
COACH_API_MODE=live

# Only read in fixture mode. `empty` serves the zero-trainee roster (AC1's empty
# state, and what the Playwright specs assert); anything else serves Lina M.
COACH_FIXTURE_SCENARIO=populated

# The host the invite link and its QR code are built from. The composed link is
# <INVITE_BASE_URL>/i/<token>. For the demo this MUST be the laptop's LAN IP, not
# localhost: a phone scanning the QR cannot resolve localhost.
#   ipconfig getifaddr en0        -> e.g. 192.168.1.24
#   npm run dev -- -H 0.0.0.0     -> Next binds to the LAN, not just loopback
INVITE_BASE_URL=http://localhost:3300

# EV-341w release hold. `on` (exactly) shows the overview's « Entretien » card (« Demander
# l'accord ») and its poll route. Unset = off, which is the deployment default until EV-341b
# ships with it and the trainee app's answer screen (EV-341q) is in a shipped build.
# Deployment-wide: `on` shows the card to every coach this deployment serves (no allow-list).
# COACH_INTAKE_REQUEST=on
