{
  "root": true,
  "extends": "next/core-web-vitals",
  "ignorePatterns": [".next/", "node_modules/", "next-env.d.ts"],
  "rules": {
    "eqeqeq": ["error", "smart"],
    "no-var": "error",
    "prefer-const": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "next/link",
            "message": "Use @/components/ui/Link (prefetch={false}): ADR-0033 D33.13 invariant N, the portal sends no AUTO prefetch. Only roster/IntentLink.tsx may import next/link."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/ui/Link.tsx", "src/components/roster/IntentLink.tsx"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "plugins": ["@typescript-eslint"],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_",
            "ignoreRestSiblings": true
          }
        ]
      }
    }
  ]
}
